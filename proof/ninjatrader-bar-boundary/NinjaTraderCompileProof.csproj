<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>StratCoreBarBoundaryInspector</AssemblyName>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <UseWPF>true</UseWPF>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NinjaTraderInstallDir Condition="'$(NinjaTraderInstallDir)' == ''">C:\Program Files\NinjaTrader 8</NinjaTraderInstallDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\BarBoundaryEngine.cs" />
    <Compile Include="src\StratCoreBarBoundaryInspector.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="NinjaTrader.Core">
      <HintPath>$(NinjaTraderInstallDir)\bin\NinjaTrader.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NinjaTrader.Gui">
      <HintPath>$(NinjaTraderInstallDir)\bin\NinjaTrader.Gui.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NinjaTrader.Custom">
      <HintPath>$(NinjaTraderInstallDir)\bin\Custom\Backup\NinjaTrader.Custom.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
